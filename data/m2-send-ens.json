      "carries": [
        "ip",
        "ens_name"
      ],
      "births": [
        "recipient"
      ],
      "returns": "the address you send to",
      "can_block": true,
      "on_failure": "blocks",
      "worst_lie": {
        "outcome": "funds_lost",
        "note": "a lying answer sends the money to the wrong address"
      },
      "removable_by": "custom_rpc",
      "provenance": {
        "status": "observed",
        "ref": "20260821-214213-send-ens · core/ens-controller"
