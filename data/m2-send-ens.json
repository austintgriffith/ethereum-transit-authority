      "actor": "ccip-issuer",
      "purpose": "CCIP-Read resolution for offchain subnames",
      "need": "RT",
      "carries": [
        "ip",
        "ens_name"
      ],
      "births": [
        "recipient"
      ],
      "returns": "the address you send to",
      "can_block": true,
      "on_failure": "blocks",
      "worst_lie": {
        "outcome": "funds_lost",
        "note": "the issuer's answer is the destination"
      },
      "removable_by": "none",
      "provenance": {
        "status": "inferred",
        "ref": "CCIP-Read spec; not yet traced in MetaMask source"
      },
      "notes": "Only fires for offchain subnames. The issuer learns who is paying this name.",
      "tx_input": "field",
      "optional": true
    },
    {
      "id": "avatar-fetch",
      "phase": "resolve",
      "name": "Avatar fetch — the trap",
      "host": "(any URL the name owner set)",
      "actor": "avatar-host",
      "purpose": "Fetch the name's avatar record",
      "need": "T",
      "carries": [
        "ip",
        "ens_name"
      ],
      "returns": "a profile picture",
      "can_block": false,
      "on_failure": "silent",
      "worst_lie": {
        "outcome": "none",
        "note": "pure surveillance: whoever set the record harvests your IP"
      },
      "removable_by": "none",
      "provenance": {
        "status": "inferred",
        "ref": "ENS avatar text record mechanics; wallet fetch path not yet traced"
      },
      "notes": "The avatar record can point at any server."
    }
  ],
